{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode/plugin-context",
  "version": "2.3.0",
  "description": "Context.dev search and page reading with Highlights for OpenCode",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/opencode.git",
    "directory": "packages/plugins/context"
  },
  "publishConfig": {
    "access": "public"
  },
